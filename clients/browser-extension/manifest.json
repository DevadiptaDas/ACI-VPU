{
  "manifest_version": 3,
  "name": "ACI Web Capture",
  "version": "0.1.0",
  "description": "Auto-captures the pages you read into your local ACI memory. 100% on-device, private, no cloud.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:7077/*",
    "http://localhost:7077/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*",
                "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["grounded.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACI Web Capture"
  }
}
